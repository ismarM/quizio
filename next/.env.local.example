# Public Firebase web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id

# Public URL used for generated sitemap and robots URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Go backend
GO_BACKEND_URL=http://localhost:8080

# Firebase Admin SDK
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-firebase-admin-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"

# Supabase server client
SUPABASE_URL=https://replace-with-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Must match the HMAC_SECRET configured in the Go backend
HMAC_SECRET=replace-with-shared-hmac-secret

# Gemini question generation
GEMINI_API_KEY=replace-with-gemini-api-key
